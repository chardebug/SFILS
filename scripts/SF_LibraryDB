CREATE DATABASE SF_LibraryDB;
USE SF_LibraryDB;


CREATE TABLE libraryLookup (
    id INT AUTO_INCREMENT PRIMARY KEY,
    home_library_code VARCHAR(15) NOT NULL,
    home_library_definition VARCHAR(50) NOT NULL, 
    within_sf_county BOOLEAN NULL
);


CREATE TABLE notificationLookup (
    id INT AUTO_INCREMENT PRIMARY KEY,
    notification_code VARCHAR(15),
    notification_definition VARCHAR(50) NOT NULL,
    provided_email_address BOOLEAN NULL
);


CREATE TABLE patronLookup (
    id INT AUTO_INCREMENT PRIMARY KEY,
    patron_type_code VARCHAR(15),
    patron_type_definition VARCHAR(50) NOT NULL,
    age_min TINYINT NULL,
    age_max TINYINT NULL
);


CREATE TABLE SF_Library_Data_staging (
    patron_type_code VARCHAR(15),
    checkout_total INT,
    renewal_total INT,
    home_library_code VARCHAR(15),
    circulation_active_month TINYINT,
    circulation_active_year SMALLINT,
    notification_code VARCHAR(15),
    provided_email_address BOOLEAN,
    year_patron_registered SMALLINT
);


CREATE TABLE SF_Library_Data (
    record_id INT AUTO_INCREMENT PRIMARY KEY,
    patron_type_code VARCHAR(15),
    checkout_total INT,
    renewal_total INT,
    home_library_code VARCHAR(15),
    circulation_active_month TINYINT,
    circulation_active_year SMALLINT,
    notification_code VARCHAR(15),
    provided_email_address BOOLEAN,
    year_patron_registered SMALLINT
);


LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 9.5/Uploads/libraryLookup.csv' 
INTO TABLE libraryLookup
FIELDS TERMINATED BY ',' 
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS
(home_library_code, home_library_definition, @within_sf_county)
SET within_sf_county = NULLIF(@within_sf_county, '');

LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 9.5/Uploads/notificationLookup.csv'
INTO TABLE notificationLookup
FIELDS TERMINATED BY ',' 
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS
(notification_code, notification_definition, @provided_email_address)
SET provided_email_address = NULLIF(@provided_email_address, '');

LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 9.5/Uploads/patronLookupCleaned.csv'
INTO TABLE patronLookup
FIELDS TERMINATED BY ',' 
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS
(patron_type_code, patron_type_definition, age_min, age_max);

CREATE TABLE SF_Library_Data_staging (
    patron_type_code VARCHAR(15),
    checkout_total INT,
    renewal_total INT,
    home_library_code VARCHAR(15),
    circulation_active_month TINYINT,
    circulation_active_year SMALLINT,
    notification_code VARCHAR(15),
    provided_email_address BOOLEAN,
    year_patron_registered SMALLINT
);

CREATE TABLE SF_Library_Data (
    record_id INT AUTO_INCREMENT PRIMARY KEY,
    patron_type_code VARCHAR(15),
    checkout_total INT,
    renewal_total INT,
    home_library_code VARCHAR(15),
    circulation_active_month TINYINT,
    circulation_active_year SMALLINT,
    notification_code VARCHAR(15),
    provided_email_address BOOLEAN,
    year_patron_registered SMALLINT
);

LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 9.5/Uploads/SFPL_Data.csv'
INTO TABLE SF_Library_Data_staging
FIELDS TERMINATED BY ',' 
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS
(
  patron_type_code, 
  checkout_total, 
  renewal_total, 
  home_library_code, 
  @circulation_active_month,
  @circulation_active_year,
  notification_code, 
  @provided_email_address,
  year_patron_registered
)
SET 
  circulation_active_month = CASE @circulation_active_month
        WHEN 'January' THEN 1
        WHEN 'February' THEN 2
        WHEN 'March' THEN 3
        WHEN 'April' THEN 4
        WHEN 'May' THEN 5
        WHEN 'June' THEN 6
        WHEN 'July' THEN 7
        WHEN 'August' THEN 8
        WHEN 'September' THEN 9
        WHEN 'October' THEN 10
        WHEN 'November' THEN 11
        WHEN 'December' THEN 12
        ELSE NULL
    END,
  circulation_active_year = NULLIF(@circulation_active_year, 'NULL'),
  provided_email_address = NULLIF(@provided_email_address, 'NULL');


-- Kept getting timed out, so I had to do batches. 

-- Batch 1
INSERT INTO SF_Library_Data
(patron_type_code, checkout_total, renewal_total, home_library_code,
 circulation_active_month, circulation_active_year, notification_code, provided_email_address, year_patron_registered)
SELECT
  patron_type_code,
  checkout_total,
  renewal_total,
  home_library_code,
  circulation_active_month,
  circulation_active_year,
  notification_code,
  provided_email_address,
  year_patron_registered
FROM SF_Library_Data_staging
LIMIT 50000 OFFSET 0;

-- Batch 2
INSERT INTO SF_Library_Data
(patron_type_code, checkout_total, renewal_total, home_library_code,
 circulation_active_month, circulation_active_year, notification_code, provided_email_address, year_patron_registered)
