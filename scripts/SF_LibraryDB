  patron_type_code,
  checkout_total,
  renewal_total,
  home_library_code,
  circulation_active_month,
  circulation_active_year,
  notification_code,
  provided_email_address,
  year_patron_registered
FROM SF_Library_Data_staging
LIMIT 50000 OFFSET 50000;

