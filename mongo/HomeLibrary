// Identify home library codes and their definitions and then count how many patrons there are 
db.Patron.aggregate([
  { 
    $group: { 
      _id: { 
        home_library_code: "$home_library_code",
        home_library_definition: "$home_library_definition"
      },
      count: { $sum: 1 }
    }
  },
  { $sort: { count: -1 } }
])

  
