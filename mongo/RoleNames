// Find the patron codes and patron types definition
db.Patron.aggregate([
  { 
    $group: { 
      _id: { 
        patron_type_code: "$patron_type_code",
        patron_type_definition: "$patron_type_definition"
      }
    } 
  },
  { $sort: { "_id.patron_type_code": 1 } }
])

// Label patrons by their code number
db.Patron.updateMany({}, [
  {
    $set: {
      role_name: {
        $switch: {
          branches: [
            { case: { $eq: ["$patron_type_code", 0] }, then: "Adult" },
            { case: { $eq: ["$patron_type_code", 1] }, then: "Juvenile" },
            { case: { $eq: ["$patron_type_code", 2] }, then: "Teen" },
            { case: { $eq: ["$patron_type_code", 3] }, then: "Senior" },
            { case: { $eq: ["$patron_type_code", 4] }, then: "Welcome" },
            { case: { $eq: ["$patron_type_code", 5] }, then: "Staff" },
            { case: { $eq: ["$patron_type_code", 10] }, then: "Visitor" },
            { case: { $eq: ["$patron_type_code", 11] }, then: "Business" },
            { case: { $eq: ["$patron_type_code", 12] }, then: "Library By Mail" },
            { case: { $eq: ["$patron_type_code", 15] }, then: "Teacher Card" },
            { case: { $eq: ["$patron_type_code", 16] }, then: "Digital Access Card" },
            { case: { $eq: ["$patron_type_code", 17] }, then: "Bibliocommons" },
            { case: { $eq: ["$patron_type_code", 55] }, then: "Retired Staff" },
            { case: { $eq: ["$patron_type_code", 100] }, then: "At User Adult" },
            { case: { $eq: ["$patron_type_code", 101] }, then: "At User Juvenile" },
            { case: { $eq: ["$patron_type_code", 102] }, then: "At User Teen" },
            { case: { $eq: ["$patron_type_code", 103] }, then: "At User Senior" },
            { case: { $eq: ["$patron_type_code", 104] }, then: "At User Welcome" }
          ],
          default: "None"
        }
      }
    }
  }
])

// Count how many patrons per group
db.Patron.aggregate([
  { $group: { _id: "$role_name", count: { $sum: 1 } } },
  { $sort: { count: -1 } }
])
